{
  "name": "luz-verde-luz-roja",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PWA infantil de Luz Verde, Luz Roja con deteccion de pose local para iPad",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify:offline": "node scripts/verify-offline.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luiskhernandez/green-red-light.git"
  },
  "license": "ISC",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
